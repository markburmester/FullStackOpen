root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# JavaScript, JSX, TypeScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# CSS, SCSS files
[*.{css,scss}]
indent_size = 2

# HTML files
[*.{html,htm}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Python files
[*.py]
indent_size = 4

# Dockerfile
[Dockerfile]
indent_size = 2

# .gitignore, .gitattributes
[.git*]
end_of_line = lf
